#!/usr/bin/env bash
# justvideo — optimize a video for the web.
# Output: H.264 MP4, capped at 720p, faststart for streaming. Tuned for small
# file size at reasonable quality. Writes "<name>-web.mp4" next to each input.
#
# usage: justvideo [-o [dir]] [-f] [video ...]
#   with no videos: converts every video in the current folder, JOBS at a time
#   -o [dir]  write outputs to dir (created if needed); bare -o means ./output
#   -f        replace the original file instead of writing "<name>-web.mp4"
#             (non-mp4 sources become "<name>.mp4" and the original is removed;
#              combined with -o, just drops the -web suffix — source is kept)
#   env overrides:  CRF=28  PRESET=slow  AUDIO_BR=128k  JOBS=8  (higher CRF = smaller)

set -uo pipefail

CRF=${CRF:-28}            # 18=high quality .. 30=small; 28 favours size
PRESET=${PRESET:-slow}    # slower preset = better compression at same CRF
AUDIO_BR=${AUDIO_BR:-128k}
JOBS=${JOBS:-8}           # parallel encodes in folder mode
STATS=-stats              # cleared in folder mode: parallel progress lines interleave

usage() {
  sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
}

OUTDIR=
INPLACE=0
inputs=()
while [ $# -gt 0 ]; do
  case $1 in
    -o)
      # value is optional: only consume the next arg if it isn't an existing
      # file (i.e. an input video) or another flag
      if [ $# -ge 2 ] && [ "${2#-}" = "$2" ] && [ ! -f "$2" ]; then
        OUTDIR=$2; shift
      else
        OUTDIR=output
      fi ;;
    -f) INPLACE=1 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; inputs+=("$@"); break ;;
    -*) echo "justvideo: unknown option: $1" >&2; usage >&2; exit 2 ;;
    *) inputs+=("$1") ;;
  esac
  shift
done

command -v ffmpeg >/dev/null 2>&1 || { echo "justvideo: ffmpeg not found on PATH" >&2; exit 1; }

if [ -n "$OUTDIR" ]; then
  OUTDIR=$(cygpath -u "$OUTDIR" 2>/dev/null || printf '%s' "$OUTDIR")
  mkdir -p "$OUTDIR" || { echo "justvideo: cannot create output dir: $OUTDIR" >&2; exit 1; }
fi

human() { numfmt --to=iec --suffix=B "$1" 2>/dev/null || echo "${1}B"; }
size_of() { stat -c%s "$1" 2>/dev/null || stat -f%z "$1" 2>/dev/null || echo 0; }

encode_one() {
  local in=$1 dir base outdir out tmp before after same
  # accept Windows-style paths when invoked via the .cmd shim (PowerShell/cmd)
  in=$(cygpath -u "$in" 2>/dev/null || printf '%s' "$in")
  if [ ! -f "$in" ]; then
    echo "justvideo: not found: $in" >&2
    return 1
  fi

  dir=$(dirname "$in")
  base=$(basename "$in")
  outdir=${OUTDIR:-$dir}
  if [ "$INPLACE" = 1 ]; then
    out="$outdir/${base%.*}.mp4"
  else
    out="$outdir/${base%.*}-web.mp4"
  fi
  tmp="$out.$BASHPID.tmp.mp4"
  before=$(size_of "$in")

  echo ">> $base"
  if ffmpeg -hide_banner -loglevel error $STATS -nostdin -y -i "$in" \
      -vf "scale='min(1280,iw)':'min(720,ih)':force_original_aspect_ratio=decrease:force_divisible_by=2,format=yuv420p" \
      -c:v libx264 -preset "$PRESET" -crf "$CRF" \
      -c:a aac -b:a "$AUDIO_BR" \
      -movflags +faststart \
      "$tmp"; then
    [ "$in" -ef "$out" ] && same=1 || same=0
    mv -f "$tmp" "$out"
    # -f without -o: the encode replaces the source; drop a differently-named
    # original (e.g. .mkv -> .mp4) once the new file is safely in place
    if [ "$INPLACE" = 1 ] && [ -z "$OUTDIR" ] && [ "$same" = 0 ]; then
      rm -f "$in"
    fi
    after=$(size_of "$out")
    echo "   $base: $(human "$before")  ->  $(human "$after")   ${out}"
  else
    rm -f "$tmp"
    echo "justvideo: encode failed: $in" >&2
    return 1
  fi
}

status=0
if [ "${#inputs[@]}" -eq 0 ]; then
  # no inputs: pick up every video in the current folder (skip earlier outputs)
  shopt -s nullglob nocaseglob
  files=()
  for f in *.mp4 *.m4v *.mov *.mkv *.avi *.webm *.wmv *.flv *.mpg *.mpeg *.ts *.m2ts *.mts *.3gp *.ogv; do
    case "${f,,}" in *-web.mp4|*.tmp.mp4) continue ;; esac
    files+=("$f")
  done
  shopt -u nullglob nocaseglob

  if [ "${#files[@]}" -eq 0 ]; then
    echo "justvideo: no videos found in $PWD" >&2
    exit 1
  fi

  echo "justvideo: ${#files[@]} video(s), up to $JOBS in parallel${OUTDIR:+ -> $OUTDIR/}"
  STATS=
  fails=$(mktemp)
  for f in "${files[@]}"; do
    while [ "$(jobs -rp | wc -l)" -ge "$JOBS" ]; do wait -n; done
    { encode_one "$f" || echo "$f" >>"$fails"; } &
  done
  wait
  [ -s "$fails" ] && status=1
  rm -f "$fails"
else
  for f in "${inputs[@]}"; do
    encode_one "$f" || status=1
  done
fi
exit $status
